# Copy to .verity/deploy.env and fill in. This file holds NON-SECRET operator
# config plus a pointer to where the DB password lives; keep real secrets out of
# git. deploy.sh sources this operator-owned file and parses release.env as data.

# --- database (compose-managed postgres) ---
POSTGRES_DB=ProjectPulse
POSTGRES_USER=projectpulse
# The compose db service needs a password. Pull it from your secret store
# (e.g. POSTGRES_PASSWORD="$(op read ...)"); do not commit a real value.
# POSTGRES_PASSWORD=

# Generate and persist a separate runtime password (openssl rand -hex 32).
# deploy.sh provisions ptp_runtime with application grants and rejects existing
# administrative privileges or object ownership. Never reuse POSTGRES_PASSWORD.
# RUNTIME_DB_PASSWORD=
# The API connection always uses ptp_runtime on the local compose db service.
# DB_CONNECTION_STRING is no longer consumed by this deployment topology.
# The compose administrator is only used for provisioning, backup and migrations.
# External managed databases require their own TLS-enabled deployment topology.

# --- web ---
WEB_PORT=8080

# --- verify gate ---
# Base URL the smoke + 021-release-smoke checks run against after `up`.
VERIFY_BASE_URL=http://localhost:8080
