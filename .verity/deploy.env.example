# Copy to .verity/deploy.env and fill in. This file holds NON-SECRET operator
# config plus a pointer to where the DB password lives; keep real secrets out of
# git. deploy.sh sources this operator-owned file and parses release.env as data.

# --- database (compose-managed postgres) ---
POSTGRES_DB=ProjectPulse
POSTGRES_USER=projectpulse
# The compose db service needs a password. Pull it from your secret store
# (e.g. POSTGRES_PASSWORD="$(op read ...)"); do not commit a real value.
# POSTGRES_PASSWORD=

# The API reads its DB connection from DB_CONNECTION_STRING (kept here, never
# committed). It must be an Npgsql connection string pointing at the db service:
# Host=db;Port=5432;Database=ProjectPulse;Username=ptp_runtime;Password=<runtime-secret>
# Provision ptp_runtime separately with application grants and no administrative
# privileges or object ownership. Never reuse POSTGRES_USER or POSTGRES_PASSWORD.
# The compose database administrator is only for provisioning and migrations.
# Use SSL Mode=Disable only for the local compose database. Or
# point it at an external managed Postgres and drop the db service.
# DB_CONNECTION_STRING=

# --- web ---
WEB_PORT=8080

# --- verify gate ---
# Base URL the smoke + 021-release-smoke checks run against after `up`.
VERIFY_BASE_URL=http://localhost:8080
