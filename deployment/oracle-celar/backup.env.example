# Copy to /etc/celar-ai/backup.env and chmod 0600.
# Never commit the real file.
#
# Example for an S3-compatible object-store backend such as OCI Object Storage:
# RESTIC_REPOSITORY=s3:https://<namespace>.compat.objectstorage.<region>.oraclecloud.com/<bucket>/celar-ai
# RESTIC_PASSWORD=<long-random-restic-repository-password>
# AWS_ACCESS_KEY_ID=<customer-secret-key-access-key>
# AWS_SECRET_ACCESS_KEY=<customer-secret-key-secret>
# AWS_DEFAULT_REGION=<oci-region>

RESTIC_REPOSITORY=
RESTIC_PASSWORD=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=
