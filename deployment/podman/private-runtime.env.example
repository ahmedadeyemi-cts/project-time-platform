# Copy to private-runtime.env on the OpenCloud VM. Do not commit the populated file.
PRIVATE_RUNTIME_BIND_IP=10.0.0.10
PRIVATE_RUNTIME_GATEWAY_PORT=443
CLAMAV_PORT=3310

PRIVATE_RUNTIME_GATEWAY_IMAGE=not-configured
OLLAMA_IMAGE=not-configured
TESSERACT_ADAPTER_IMAGE=not-configured
CLAMAV_IMAGE=not-configured

OLLAMA_MODEL=not-configured
OLLAMA_EMBEDDING_MODEL=not-configured
TESSERACT_MODEL=tesseract-5-eng

TLS_CERTIFICATE_PATH=/etc/celar-ai/tls/tls.crt
TLS_PRIVATE_KEY_PATH=/etc/celar-ai/tls/tls.key
RUNTIME_BEARER_TOKEN_FILE=/run/secrets/celar-ai-runtime-token

OLLAMA_MODELS_VOLUME=celar-ai-ollama-models
TESSERACT_WORK_VOLUME=celar-ai-tesseract-work
CLAMAV_SIGNATURES_VOLUME=celar-ai-clamav-signatures
GATEWAY_CONFIG_VOLUME=celar-ai-gateway-config
