FROM debian:bookworm-slim@sha256:3783cc01769c7b2b1b83a5c5ad96c815348e28ed7da68e2e3687004faa906251 AS isolation
RUN apt-get update && apt-get install -y --no-install-recommends gcc libc6-dev libseccomp-dev linux-libc-dev
COPY deployment/pulse-services/sandbox.c /src/sandbox.c
RUN gcc -O2 -Wall -Wextra -Werror /src/sandbox.c -lseccomp -o /pulse-sandbox && gcc -O2 -Wall -Wextra -Werror -fPIC -shared -DPULSE_SHARED /src/sandbox.c -lseccomp -o /libpulse-sandbox.so
FROM python:3.12-slim-bookworm@sha256:392307d22300de8b5986851a12d9176dfc0fc073e65bf6523ebd7dcbeb23564e
ENV DEBIAN_FRONTEND=noninteractive PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 LANG=C.UTF-8 TZ=UTC
RUN apt-get update && apt-get install -y --no-install-recommends libseccomp2 libgomp1 ca-certificates libpcre2-8-0 \
    && dpkg --compare-versions "$(dpkg-query -W -f='${Version}' libpcre2-8-0)" ge '10.42-1+deb12u2' \
    && rm -rf /var/lib/apt/lists/*
COPY --from=isolation /pulse-sandbox /usr/local/bin/pulse-sandbox
COPY --from=isolation /libpulse-sandbox.so /usr/local/lib/libpulse-sandbox.so
COPY deployment/pulse-services/requirements.lock /opt/pulse-services/requirements.lock
RUN pip install --no-cache-dir --no-deps --require-hashes -r /opt/pulse-services/requirements.lock && pip check
COPY deployment/pulse-services/download_model.py deployment/pulse-services/laya-model.json /opt/pulse-services/
RUN python /opt/pulse-services/download_model.py /opt/pulse-laya-model
COPY deployment/pulse-services/laya_worker.py deployment/pulse-services/runtime.py /opt/pulse-services/
ENV HF_HUB_OFFLINE=1 TRANSFORMERS_OFFLINE=1 HF_HUB_DISABLE_TELEMETRY=1 TOKENIZERS_PARALLELISM=false OMP_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1 MKL_NUM_THREADS=1
WORKDIR /opt/pulse-services
USER 65534:65534
CMD ["python","laya_worker.py"]
