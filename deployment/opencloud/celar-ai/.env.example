# Pin every image to a verified registry manifest digest, not a mutable tag.
TARGET_PLATFORM=linux/amd64
HTTPS_BIND_IP=0.0.0.0
CELAR_LOCAL_DIR=/srv/celarai-dev/config
CELAR_GATEWAY_IMAGE=
OLLAMA_IMAGE=
CELAR_LAYA_IMAGE=
CADDY_IMAGE=
# Laya image must supply the installed worker, its locked dependencies and the
# documented Unix-socket contract. Its source/checkpoint is not in this repo.
