{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pulse.ussignal.com/schemas/full-future-loop/automation-policy.schema.json",
  "title": "Pulse Full Future Loop Automation Policy",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "policyVersion",
    "enabled",
    "globalKillSwitch",
    "allowedRepositories",
    "allowedEnvironments",
    "allowedOperations",
    "automaticActions",
    "approvalRequirements",
    "limits",
    "evidenceMaximumAgeMinutes"
  ],
  "properties": {
    "policyVersion": {
      "type": "string",
      "minLength": 3,
      "maxLength": 120,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "enabled": { "type": "boolean" },
    "globalKillSwitch": { "type": "boolean" },
    "allowedRepositories": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
      }
    },
    "allowedEnvironments": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "enum": ["canary", "test", "production"] }
    },
    "allowedOperations": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "observe",
          "classify",
          "create_issue",
          "dispatch_ci",
          "run_canary",
          "deploy",
          "verify",
          "rollback",
          "notify",
          "propose_repair"
        ]
      }
    },
    "automaticActions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "testDeployment",
        "testRollback",
        "productionDeployment",
        "productionRollback"
      ],
      "properties": {
        "testDeployment": { "type": "boolean" },
        "testRollback": { "type": "boolean" },
        "productionDeployment": { "type": "boolean" },
        "productionRollback": { "type": "boolean" }
      }
    },
    "approvalRequirements": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "production",
        "migration",
        "security",
        "infrastructure",
        "secretChange"
      ],
      "properties": {
        "production": { "type": "boolean" },
        "migration": { "type": "boolean" },
        "security": { "type": "boolean" },
        "infrastructure": { "type": "boolean" },
        "secretChange": { "type": "boolean" }
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["maximumConcurrentRuns", "maximumStepAttempts", "maximumRunMinutes"],
      "properties": {
        "maximumConcurrentRuns": { "type": "integer", "minimum": 1, "maximum": 20 },
        "maximumStepAttempts": { "type": "integer", "minimum": 1, "maximum": 10 },
        "maximumRunMinutes": { "type": "integer", "minimum": 5, "maximum": 1440 }
      }
    },
    "evidenceMaximumAgeMinutes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10080
    },
    "approvedProductionChangeTypes": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 120
      },
      "default": []
    }
  }
}
