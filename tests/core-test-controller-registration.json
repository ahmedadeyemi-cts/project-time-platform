  "coreBlock": "\n\n      - name: Admit exact merged main core release\n        if: inputs.core_only\n        working-directory: release\n        env:\n          RELEASE_SHA: ${{ inputs.release_sha }}\n          RELEASE_BRANCH: ${{ inputs.release_branch }}\n          RECOVER_ORACLE: ${{ inputs.recover_private_runtime }}\n          QUALIFICATION: ${{ inputs.qualification_provider }}\n          CLEANUP: ${{ inputs.stale_sow_cleanup_mode }}\n          ADMISSION_CONTROLLER: ${{ inputs.admission_controller_sha }}\n          GH_TOKEN: ${{ github.token }}\n        run: |\n          set -Eeuo pipefail\n          [[ \"$RELEASE_BRANCH\" == main && \"$RECOVER_ORACLE\" != true && \"$QUALIFICATION\" == none && \"$CLEANUP\" == none && -z \"$ADMISSION_CONTROLLER\" ]]\n          bash scripts/resilience/admit-core-main.sh\n\n      - name: Sign in for admitted core Test release\n        if: inputs.core_only\n        uses: azure/login@a457da9ea143d694b1b9c7c869ebb04ebe844ef5\n        with:\n          client-id: ${{ vars.AZURE_CLIENT_ID }}\n          tenant-id: ${{ vars.AZURE_TENANT_ID }}\n          subscription-id: ${{ vars.AZURE_SUBSCRIPTION_ID }}\n\n      - name: Stage, authenticate, validate recovery, and deploy core Test API\n        if: inputs.core_only\n        working-directory: release\n        env:\n          RELEASE_SHA: ${{ inputs.release_sha }}\n          AZURE_SUBSCRIPTION_ID: ${{ vars.AZURE_SUBSCRIPTION_ID }}\n          AZURE_RESOURCE_GROUP: ${{ vars.AZURE_RESOURCE_GROUP }}\n          AZURE_API_APP: ${{ vars.AZURE_API_APP }}\n          AZURE_ACR_NAME: ${{ vars.AZURE_ACR_NAME }}\n          TEST_LOGIN_PASSWORD: ${{ secrets.PROJECTPULSE_M087_PASSWORD }}\n          GH_TOKEN: ${{ github.token }}\n          CORE_EVIDENCE_FILE: ${{ runner.temp }}/core-test-release-summary.json\n        run: bash scripts/resilience/core-test-release-controller.sh\n\n      - name: Publish redacted core Test release evidence\n        if: ${{ always() && inputs.core_only }}\n        uses: actions/upload-artifact@ea165f8d65b6e75b540449e92b4886f43607fa02\n        with:\n          name: core-test-release-${{ github.run_id }}-${{ github.run_attempt }}\n          path: ${{ runner.temp }}/core-test-release-summary.json\n          if-no-files-found: warn\n          retention-days: 7\n",
