<Project>
  <!--
    The governed Protected-Test release controller stages a temporary, untracked
    .projectpulse-source-revision file containing the exact reviewed 40-character
    candidate SHA. Ordinary builds do not have that file and remain unbound.
  -->
  <PropertyGroup Condition="'$(ProjectPulseSourceRevision)' == '' and Exists('$(MSBuildProjectDirectory)/.projectpulse-source-revision')">
    <ProjectPulseSourceRevision>$([System.IO.File]::ReadAllText('$(MSBuildProjectDirectory)/.projectpulse-source-revision'))</ProjectPulseSourceRevision>
  </PropertyGroup>

  <PropertyGroup>
    <ModuleAvailabilityResilienceGeneratedDirectory>$(MSBuildProjectDirectory)/obj/module-availability-resilience</ModuleAvailabilityResilienceGeneratedDirectory>
    <ModuleAvailabilityResilienceGenerated>$(ModuleAvailabilityResilienceGeneratedDirectory)/ModuleAvailabilityModule.Resilient.g.cs</ModuleAvailabilityResilienceGenerated>
    <FlowHivePrivateExtractorGeneratedDirectory>$(MSBuildProjectDirectory)/obj/flowhive-private-document</FlowHivePrivateExtractorGeneratedDirectory>
    <FlowHivePrivateExtractorGenerated>$(FlowHivePrivateExtractorGeneratedDirectory)/PulseAiPrivateDocumentExtractionService.g.cs</FlowHivePrivateExtractorGenerated>
    <CustomerSourceAuthorityGeneratedDirectory>$(MSBuildProjectDirectory)/obj/customer-source-authority</CustomerSourceAuthorityGeneratedDirectory>
    <CustomerSourceCommercialGenerated>$(CustomerSourceAuthorityGeneratedDirectory)/SellCommercialReadModelModule.CustomerSource.g.cs</CustomerSourceCommercialGenerated>
  </PropertyGroup>

  <!--
    ProjectTime.Api.csproj evaluates PulseAiPrivateExtractorGenerated before
    IntermediateOutputPath is populated, which can resolve the generated private
    extractor into tracked source. Redirect that compiler copy immediately before
    GenerateScopedRbacSources executes and remove the historic tracked generated
    copy from Compile. The canonical Ai source remains the reviewable authority,
    while all build-time FlowHive compatibility edits stay under ignored obj/.
  -->
  <Target Name="PrepareFlowHivePrivateExtractorGeneratedPath"
          BeforeTargets="GenerateScopedRbacSources">
    <PropertyGroup>
      <PulseAiPrivateExtractorGenerated>$(FlowHivePrivateExtractorGenerated)</PulseAiPrivateExtractorGenerated>
    </PropertyGroup>
    <MakeDir Directories="$(FlowHivePrivateExtractorGeneratedDirectory)" />
    <ItemGroup>
      <Compile Remove="PulseAiPrivateDocumentExtractionService.g.cs" />
    </ItemGroup>
  </Target>

  <!--
    The API project already generates a compiler-compatible private document
    extractor during GenerateScopedRbacSources. Apply the reviewed legacy Word
    adapter only to that ignored compiler copy after the existing ClosedXML
    compatibility rewrite. The canonical extractor remains readable and the
    post-processor fails closed if any expected source anchor changes.

    Make GenerateScopedRbacSources an explicit dependency rather than relying on
    target ordering alone. Protected-Test evidence proved that a runtime can
    otherwise reach the canonical safety path and reject the sealed local SMB
    processing snapshot before the legacy Word adapter is reachable.
  -->
  <Target Name="EnableFlowHiveLegacyWordExtraction"
          BeforeTargets="CoreCompile"
          DependsOnTargets="GenerateScopedRbacSources"
          Condition="'$(PulseAiPrivateExtractorGenerated)' != ''">
    <Exec Command="python3 &quot;$(MSBuildProjectDirectory)/build/enable-flowhive-legacy-word-extraction.py&quot; --path &quot;$(PulseAiPrivateExtractorGenerated)&quot;" />
    <Exec Command="grep -Fq '&quot;.doc&quot; =&gt; await PulseAiLegacyBinaryWordExtraction.ExtractAsync' &quot;$(PulseAiPrivateExtractorGenerated)&quot;" />
    <Exec Command="grep -Fq 'extension.Equals(&quot;.doc&quot;, StringComparison.OrdinalIgnoreCase)' &quot;$(PulseAiPrivateExtractorGenerated)&quot;" />
    <Exec Command="grep -Fq 'ole_compound_word' &quot;$(PulseAiPrivateExtractorGenerated)&quot;" />
    <Exec Command="grep -Fq 'PulseAiImmutableProcessingSnapshotPolicy.IsTrustedLocalSnapshotPath(source, fullPath)' &quot;$(PulseAiPrivateExtractorGenerated)&quot;" />
    <Exec Command="grep -Fq 'blocked_by_document_path_policy' &quot;$(PulseAiPrivateExtractorGenerated)&quot;" />
    <Exec Command="grep -Fq 'blocked_by_document_signature_policy' &quot;$(PulseAiPrivateExtractorGenerated)&quot;" />
  </Target>

  <!--
    Module availability is governance metadata, not the application data plane.
    Build a guarded compiler copy that uses the canonical PTP database settings,
    preserves any known disabled state, and follows the documented default-enabled
    policy when the optional availability store cannot be read. Endpoint-local
    authentication, permissions, project scope, and write controls remain active.
  -->
  <Target Name="GenerateModuleAvailabilityRuntimeResilience"
          BeforeTargets="CoreCompile">
    <MakeDir Directories="$(ModuleAvailabilityResilienceGeneratedDirectory)" />
    <Exec Command="python3 &quot;$(MSBuildProjectDirectory)/build/generate-module-availability-runtime-resilience.py&quot; --input &quot;$(MSBuildProjectDirectory)/Modules/ModuleAvailabilityModule.cs&quot; --output &quot;$(ModuleAvailabilityResilienceGenerated)&quot;" />
    <Exec Command="grep -Fq 'degraded-default-enabled' &quot;$(ModuleAvailabilityResilienceGenerated)&quot;" />
    <Exec Command="grep -Fq 'ProjectPulseModuleAvailabilityDegraded' &quot;$(ModuleAvailabilityResilienceGenerated)&quot;" />
    <Exec Command="grep -Fq 'availability_store_unreachable' &quot;$(ModuleAvailabilityResilienceGenerated)&quot;" />
    <Exec Command="grep -Fq 'MaxPoolSize = 30' &quot;$(ModuleAvailabilityResilienceGenerated)&quot;" />
    <ItemGroup>
      <Compile Remove="Modules/ModuleAvailabilityModule.cs" />
      <Compile Include="$(ModuleAvailabilityResilienceGenerated)" />
    </ItemGroup>
  </Target>

  <!--
    Module 021 now owns one explicit customer-source authority. Keep the canonical
    SELL commercial reader reviewable while compiling a guarded source-aware copy
    for Module 042 and other downstream commercial consumers.
  -->
  <Target Name="GenerateCustomerSourceAwareCommercialReadModel"
          BeforeTargets="CoreCompile">
    <MakeDir Directories="$(CustomerSourceAuthorityGeneratedDirectory)" />
    <Exec Command="python3 &quot;$(MSBuildProjectDirectory)/build/generate-customer-source-aware-commercial-read-model.py&quot; --input &quot;$(MSBuildProjectDirectory)/Modules/SellCommercialReadModelModule.cs&quot; --output &quot;$(CustomerSourceCommercialGenerated)&quot;" />
    <Exec Command="grep -Fq 'CustomerSourceAuthorityModule.LoadAuthorityAsync' &quot;$(CustomerSourceCommercialGenerated)&quot;" />
    <Exec Command="grep -Fq 'manual_source_active' &quot;$(CustomerSourceCommercialGenerated)&quot;" />
    <Exec Command="grep -Fq 'crm_source_active' &quot;$(CustomerSourceCommercialGenerated)&quot;" />
    <ItemGroup>
      <Compile Remove="Modules/SellCommercialReadModelModule.cs" />
      <Compile Include="$(CustomerSourceCommercialGenerated)" />
    </ItemGroup>
  </Target>

  <!-- The generated Program remains the single endpoint composition authority. -->
  <Target Name="RegisterCustomerSourceAuthorityEndpoints"
          AfterTargets="GenerateScopedRbacSources"
          BeforeTargets="CoreCompile">
    <Exec Command="grep -Fq 'app.MapCustomerSourceAuthorityEndpoints();' &quot;$(ScopedRbacGeneratedProgram)&quot; || sed -i '/app.Run();/i app.MapCustomerSourceAuthorityEndpoints();' &quot;$(ScopedRbacGeneratedProgram)&quot;" />
    <Exec Command="grep -Fq 'app.MapCustomerSourceAuthorityEndpoints();' &quot;$(ScopedRbacGeneratedProgram)&quot;" />
  </Target>

  <!-- Module 025 remains a focused endpoint module and does not enlarge generated Program source. -->
  <Target Name="RegisterModule025SowGsdEndpoints"
          AfterTargets="GenerateScopedRbacSources"
          BeforeTargets="CoreCompile">
    <Exec Command="grep -Fq 'app.MapModule025SowGsdEndpoints();' &quot;$(ScopedRbacGeneratedProgram)&quot; || sed -i '/app.Run();/i app.MapModule025SowGsdEndpoints();' &quot;$(ScopedRbacGeneratedProgram)&quot;" />
    <Exec Command="grep -Fq 'app.UseProjectPulsePublicOriginCompatibility();' &quot;$(ScopedRbacGeneratedProgram)&quot; || sed -i '/app.MapModule025SowGsdEndpoints();/i app.UseProjectPulsePublicOriginCompatibility();' &quot;$(ScopedRbacGeneratedProgram)&quot;" />
    <Exec Command="grep -Fq 'app.UseProjectPulsePublicOriginCompatibility();' &quot;$(ScopedRbacGeneratedProgram)&quot;" />
    <Exec Command="grep -Fq 'app.MapModule025SowGsdEndpoints();' &quot;$(ScopedRbacGeneratedProgram)&quot;" />
  </Target>
</Project>
