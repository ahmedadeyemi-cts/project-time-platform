<Project>
  <PropertyGroup>
    <AnalyticsGeneratedDirectory>$(MSBuildProjectDirectory)/obj/analytics-enterprise</AnalyticsGeneratedDirectory>
    <AnalyticsScheduleServiceGenerated>$(AnalyticsGeneratedDirectory)/AnalyticsCenterScheduleService.g.cs</AnalyticsScheduleServiceGenerated>
    <AnalyticsEnterpriseModuleGenerated>$(AnalyticsGeneratedDirectory)/AnalyticsCenterEnterpriseExperienceModule.g.cs</AnalyticsEnterpriseModuleGenerated>
    <CelarAiGeneratedDirectory>$(MSBuildProjectDirectory)/obj/celar-ai-enterprise</CelarAiGeneratedDirectory>
    <CelarAiPeopleGenerated>$(CelarAiGeneratedDirectory)/CelarAiPeopleAndGuidanceService.g.cs</CelarAiPeopleGenerated>
    <CelarAiBrandGenerated>$(CelarAiGeneratedDirectory)/CelarAiBrandModule.g.cs</CelarAiBrandGenerated>
    <CelarAiEnterpriseGenerated>$(CelarAiGeneratedDirectory)/CelarAiEnterprisePlatformService.g.cs</CelarAiEnterpriseGenerated>
    <CelarAiRoutingGenerated>$(CelarAiGeneratedDirectory)/CelarAiCapabilityRouting.g.cs</CelarAiRoutingGenerated>
    <PulseAiPrivateRagGenerated>$(CelarAiGeneratedDirectory)/PulseAiPrivateRagService.g.cs</PulseAiPrivateRagGenerated>
    <CelarAiTimesheetGenerated>$(CelarAiGeneratedDirectory)/ProjectPulseAiTimeEntrySuggestionService.g.cs</CelarAiTimesheetGenerated>
    <CelarAiExternalReasoningGenerated>$(CelarAiGeneratedDirectory)/CelarAiExternalReasoningService.g.cs</CelarAiExternalReasoningGenerated>
    <!--
      The existing project computes this property before IntermediateOutputPath is
      populated, which otherwise resolves the generated Program into the source
      directory and causes validation builds to modify tracked source. Override it
      to an explicitly ignored intermediate directory for every build.
    -->
    <ScopedRbacGeneratedProgram>$(AnalyticsGeneratedDirectory)/Program.ScopedRbac.g.cs</ScopedRbacGeneratedProgram>
    <!-- Module 026 has the same early-evaluation issue. Keep its transformed
         compiler copy under the ignored intermediate boundary as well. -->
    <Module026GeneratedIntegration>$(AnalyticsGeneratedDirectory)/CrmErpIntegrationModule.g.cs</Module026GeneratedIntegration>
    <!-- System intelligence is generated by the canonical API project before
         IntermediateOutputPath is populated. Keep that compiler copy out of
         tracked source so an ordinary build cannot dirty the repository. -->
    <PulseAiSystemIntelligenceGenerated>$(AnalyticsGeneratedDirectory)/PulseAiSystemIntelligenceService.g.cs</PulseAiSystemIntelligenceGenerated>
  </PropertyGroup>

  <!--
    Keep reviewed canonical Analytics and Celar AI sources readable while using
    deterministic compiler-compatible copies inside ignored intermediate folders.
  -->
  <ItemGroup>
    <Compile Remove="Program.ScopedRbac.g.cs" />
    <Compile Remove="CrmErpIntegrationModule.g.cs" />
    <Compile Remove="PulseAiSystemIntelligenceService.g.cs" />
    <Compile Remove="Modules/AnalyticsCenterScheduleService.cs" />
    <Compile Remove="Modules/AnalyticsCenterEnterpriseExperienceModule.cs" />
    <Compile Remove="Ai/CelarAiPeopleAndGuidanceService.cs" />
    <Compile Remove="Modules/CelarAiBrandModule.cs" />
    <Compile Remove="Ai/CelarAiEnterprisePlatformService.cs" />
    <Compile Remove="Ai/CelarAiCapabilityRouting.cs" />
    <Compile Remove="Ai/PulseAiPrivateRagService.cs" />
    <Compile Remove="ProjectPulseAiTimeEntrySuggestionService.cs" />
    <Compile Remove="Ai/CelarAiExternalReasoningService.cs" />
  </ItemGroup>

  <Target Name="PrepareAnalyticsGeneratedDirectory"
          BeforeTargets="GenerateScopedRbacSources;PrepareAnalyticsCenterEnterpriseCompileSources">
    <MakeDir Directories="$(AnalyticsGeneratedDirectory)" />
  </Target>

  <Target Name="PrepareCelarAiGeneratedDirectory"
          BeforeTargets="GenerateCelarAiEnterpriseCompatibilitySources">
    <MakeDir Directories="$(CelarAiGeneratedDirectory)" />
  </Target>

  <Target Name="PrepareAnalyticsCenterEnterpriseCompileSources"
          BeforeTargets="CoreCompile">
    <MakeDir Directories="$(AnalyticsGeneratedDirectory)" />
    <Exec Command="sed -e 's/var nextRun = request.Enabled/DateTimeOffset? nextRun = request.Enabled/' -e 's/var next = schedule.Enabled/DateTimeOffset? next = schedule.Enabled/' &quot;$(MSBuildProjectDirectory)/Modules/AnalyticsCenterScheduleService.cs&quot; &gt; &quot;$(AnalyticsScheduleServiceGenerated)&quot;" />
    <Exec Command="sed -e 's/? (project.LaborBudget ?? 0m) + (project.ExpenseBudget ?? 0m)/? (decimal?)((project.LaborBudget ?? 0m) + (project.ExpenseBudget ?? 0m))/' &quot;$(MSBuildProjectDirectory)/Modules/AnalyticsCenterEnterpriseExperienceModule.cs&quot; &gt; &quot;$(AnalyticsEnterpriseModuleGenerated)&quot;" />
    <ItemGroup>
      <Compile Include="$(AnalyticsScheduleServiceGenerated)" />
      <Compile Include="$(AnalyticsEnterpriseModuleGenerated)" />
    </ItemGroup>
  </Target>

  <!--
    The canonical API project generates its top-level Program source before
    CoreCompile. Add the Analytics enterprise experience after the existing
    Module 030 mapping without rewriting the oversized ProjectTime.Api.csproj.
  -->
  <Target Name="RegisterAnalyticsCenterEnterpriseExperience"
          AfterTargets="GenerateScopedRbacSources"
          BeforeTargets="CoreCompile">
    <Exec Command="grep -Fq 'app.MapAnalyticsCenterEnterpriseExperienceEndpoints();' &quot;$(ScopedRbacGeneratedProgram)&quot; || sed -i '/app.MapAnalyticsCenterEndpoints();/a app.MapAnalyticsCenterEnterpriseExperienceEndpoints();' &quot;$(ScopedRbacGeneratedProgram)&quot;" />
  </Target>

  <Target Name="GenerateCelarAiEnterpriseCompatibilitySources" BeforeTargets="CoreCompile">
    <MakeDir Directories="$(CelarAiGeneratedDirectory)" />

    <!-- Preserve the canonical people/guidance source while compiling the
         effective-user identifier into the durable assistant-message write. -->
    <Exec Command="awk 'BEGIN { in_return=0; in_record=0; in_finish=0; fixed_user=0; fixed_return=0; fixed_record=0 } /private async Task&lt;PulseAiSystemQuestionResult&gt; FinishAsync/ { in_finish=1 } /return new PersistenceContext\(/ { in_return=1 } /private sealed record PersistenceContext\(/ { in_record=1 } { if (in_finish &amp;&amp; fixed_user==0 &amp;&amp; $0 ~ /^[[:space:]]*Guid.Empty,[[:space:]]*$/) { sub(/Guid.Empty/, &quot;persistence.EffectiveUserId&quot;); fixed_user=1 } if (in_return &amp;&amp; fixed_return==0 &amp;&amp; $0 ~ /conversation is not null\);/) { print &quot;            effectiveUserId,&quot;; fixed_return=1; in_return=0 } if (in_record &amp;&amp; fixed_record==0 &amp;&amp; $0 ~ /bool Persisted\);/) { print &quot;        Guid EffectiveUserId,&quot;; fixed_record=1; in_record=0 } print } END { if (fixed_user==0 || fixed_return==0 || fixed_record==0) exit 42 }' &quot;$(MSBuildProjectDirectory)/Ai/CelarAiPeopleAndGuidanceService.cs&quot; &gt; &quot;$(CelarAiPeopleGenerated)&quot;" />

    <!-- Thread the stable tool label through recursive evidence rendering. -->
    <Exec Command="sed -i -e 's/Visit(document.RootElement, rows, maximum);/Visit(document.RootElement, rows, maximum, result.ToolName);/' -e 's/private static void Visit(JsonElement element, List&lt;string&gt; rows, int maximum)/private static void Visit(JsonElement element, List&lt;string&gt; rows, int maximum, string toolName)/' -e 's/Visit(item, rows, maximum);/Visit(item, rows, maximum, toolName);/' -e 's/Visit(property.Value, rows, maximum);/Visit(property.Value, rows, maximum, toolName);/' -e 's/{result.ToolName}:/{toolName}:/' &quot;$(CelarAiPeopleGenerated)&quot;" />

    <!-- The canonical brand module owns the enterprise/v2 registration. Verify
         the route marker and compile an exact copy so source and runtime cannot
         diverge or register the same endpoints twice. -->
    <Exec Command="grep -Fq 'endpoints.MapCelarAiEnterprisePlatformEndpoints();' &quot;$(MSBuildProjectDirectory)/Modules/CelarAiBrandModule.cs&quot;" />
    <Copy SourceFiles="$(MSBuildProjectDirectory)/Modules/CelarAiBrandModule.cs"
          DestinationFiles="$(CelarAiBrandGenerated)" />

    <Exec Command="sed -e 's/private static IEnumerable&lt;string&gt; TakeOrFallback/private static IReadOnlyList&lt;string&gt; TakeOrFallback/' &quot;$(MSBuildProjectDirectory)/Ai/CelarAiEnterprisePlatformService.cs&quot; &gt; &quot;$(CelarAiEnterpriseGenerated)&quot;" />
    <!-- The canonical router owns private-target callbacks, forced private
         document ordering, fixed public capsules, and terminal telemetry. -->
    <Exec Command="grep -Fq 'GenerateWithPrivateTargetAsync' &quot;$(MSBuildProjectDirectory)/Ai/CelarAiCapabilityRouting.cs&quot;" />
    <Exec Command="grep -Fq 'private_document_private_target_mandatory' &quot;$(MSBuildProjectDirectory)/Ai/CelarAiCapabilityRouting.cs&quot;" />
    <Copy SourceFiles="$(MSBuildProjectDirectory)/Ai/CelarAiCapabilityRouting.cs"
          DestinationFiles="$(CelarAiRoutingGenerated)" />
    <!-- The canonical private-RAG service now applies the persisted Module 064
         private-model profile itself. Verify that authority marker, then compile
         an exact generated copy instead of rewriting an obsolete one-line method. -->
    <Exec Command="grep -Fq 'CelarAiPrivateModelRuntime.Apply(PulseAiPrivateRagOptions.FromEnvironment())' &quot;$(MSBuildProjectDirectory)/Ai/PulseAiPrivateRagService.cs&quot;" />
    <Copy SourceFiles="$(MSBuildProjectDirectory)/Ai/PulseAiPrivateRagService.cs"
          DestinationFiles="$(PulseAiPrivateRagGenerated)" />

    <!-- The canonical Timesheet consumer now uses the router-owned private-target
         callback and closed public fact-code capsule directly. Compile an exact
         copy so build-time rewrites cannot reintroduce private-first routing,
         duplicate telemetry, or consumer-authored external prompts. -->
    <Exec Command="grep -Fq 'GenerateWithPrivateTargetAsync' &quot;$(MSBuildProjectDirectory)/ProjectPulseAiTimeEntrySuggestionService.cs&quot;" />
    <Exec Command="grep -Fq 'ExternalFactCodes: externalFactCodes' &quot;$(MSBuildProjectDirectory)/ProjectPulseAiTimeEntrySuggestionService.cs&quot;" />
    <Copy SourceFiles="$(MSBuildProjectDirectory)/ProjectPulseAiTimeEntrySuggestionService.cs"
          DestinationFiles="$(CelarAiTimesheetGenerated)" />

    <!-- The legacy compatibility entry point now consumes the same closed-purpose
         central router contract directly. Compile an exact copy so a generated
         rewrite cannot reintroduce caller-authored prompts or obsolete fields. -->
    <Exec Command="grep -Fq 'CelarAiCapabilityRouter _router' &quot;$(MSBuildProjectDirectory)/Ai/CelarAiExternalReasoningService.cs&quot;" />
    <Exec Command="grep -Fq 'ExternalCapsulePurpose: serverOwnedPurposeCategory' &quot;$(MSBuildProjectDirectory)/Ai/CelarAiExternalReasoningService.cs&quot;" />
    <Copy SourceFiles="$(MSBuildProjectDirectory)/Ai/CelarAiExternalReasoningService.cs"
          DestinationFiles="$(CelarAiExternalReasoningGenerated)" />

    <ItemGroup>
      <Compile Include="$(CelarAiPeopleGenerated)" />
      <Compile Include="$(CelarAiBrandGenerated)" />
      <Compile Include="$(CelarAiEnterpriseGenerated)" />
      <Compile Include="$(CelarAiRoutingGenerated)" />
      <Compile Include="$(PulseAiPrivateRagGenerated)" />
      <Compile Include="$(CelarAiTimesheetGenerated)" />
      <Compile Include="$(CelarAiExternalReasoningGenerated)" />
    </ItemGroup>
  </Target>

  <!--
    Compile guarded copies of the established Celar AI service-registration and
    production-chat sources. The generator inserts one read-only reliability
    service, one endpoint map, one evidence plan, one post-answer quality gate,
    and one sanitized reliability projection. Canonical oversized sources remain
    readable and unchanged.
  -->
  <Target Name="GenerateCelarAiUniversalAnswerReliabilitySources"
          DependsOnTargets="PrepareCelarAiGeneratedDirectory;GenerateCelarAiEnterpriseCompatibilitySources"
          BeforeTargets="CoreCompile">
    <PropertyGroup>
      <CelarAiUniversalAnswerGenerator>$(MSBuildProjectDirectory)/build/generate-celar-ai-universal-answer-reliability.awk</CelarAiUniversalAnswerGenerator>
      <CelarAiUniversalServicesGenerated>$(CelarAiGeneratedDirectory)/ProjectPulseAiServiceCollectionExtensions.Universal.g.cs</CelarAiUniversalServicesGenerated>
      <CelarAiUniversalProductionGenerated>$(CelarAiGeneratedDirectory)/CelarAiProductionPlatformModule.Universal.g.cs</CelarAiUniversalProductionGenerated>
    </PropertyGroup>
    <Exec Command="awk -v mode=services -f &quot;$(CelarAiUniversalAnswerGenerator)&quot; &quot;$(MSBuildProjectDirectory)/Ai/ProjectPulseAiServiceCollectionExtensions.cs&quot; &gt; &quot;$(CelarAiUniversalServicesGenerated)&quot;" />
    <Exec Command="awk -v mode=production -f &quot;$(CelarAiUniversalAnswerGenerator)&quot; &quot;$(MSBuildProjectDirectory)/Modules/CelarAiProductionPlatformModule.cs&quot; &gt; &quot;$(CelarAiUniversalProductionGenerated)&quot;" />
    <Exec Command="grep -Fq 'AddSingleton&lt;CelarAiUniversalAnswerReliabilityService&gt;()' &quot;$(CelarAiUniversalServicesGenerated)&quot;" />
    <Exec Command="grep -Fq 'MapCelarAiUniversalAnswerReliabilityEndpoints();' &quot;$(CelarAiUniversalProductionGenerated)&quot;" />
    <Exec Command="grep -Fq 'universalReliability.Enforce(' &quot;$(CelarAiUniversalProductionGenerated)&quot;" />
    <Exec Command="grep -Fq 'reliability = universalReliability.ToPublicEvidence(' &quot;$(CelarAiUniversalProductionGenerated)&quot;" />
    <ItemGroup>
      <Compile Remove="Ai/ProjectPulseAiServiceCollectionExtensions.cs" />
      <Compile Remove="Modules/CelarAiProductionPlatformModule.cs" />
      <Compile Include="$(CelarAiUniversalServicesGenerated)" />
      <Compile Include="$(CelarAiUniversalProductionGenerated)" />
    </ItemGroup>
  </Target>
</Project>
