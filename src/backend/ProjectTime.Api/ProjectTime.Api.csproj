<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>ProjectTime.Api</RootNamespace>
    <AssemblyName>ProjectTime.Api</AssemblyName>
    <ScopedRbacGeneratedProgram>$(IntermediateOutputPath)Program.ScopedRbac.g.cs</ScopedRbacGeneratedProgram>
    <ScopedRbacGeneratedModule>$(IntermediateOutputPath)ScopedRolePolicyModule.g.cs</ScopedRbacGeneratedModule>
    <ScopedRbacGeneratedPersistence>$(IntermediateOutputPath)ScopedRolePolicyPersistence.g.cs</ScopedRbacGeneratedPersistence>
    <DynamicRbacGeneratedModule>$(IntermediateOutputPath)DynamicRbacAdministrationModule.g.cs</DynamicRbacGeneratedModule>
    <Module026GeneratedIntegration>$(IntermediateOutputPath)CrmErpIntegrationModule.g.cs</Module026GeneratedIntegration>
    <CrmErpAdministrationExperienceGenerated>$(IntermediateOutputPath)CrmErpAdministrationExperience.g.cs</CrmErpAdministrationExperienceGenerated>
    <Module001GeneratedContracts>$(IntermediateOutputPath)Module001TimesheetContracts.g.cs</Module001GeneratedContracts>
    <Module001GeneratedData>$(IntermediateOutputPath)Module001TimesheetData.g.cs</Module001GeneratedData>
    <Module001GeneratedEndpoints>$(IntermediateOutputPath)Module001TimesheetEnhancementModule.g.cs</Module001GeneratedEndpoints>
    <PulseAiGroundingGenerated>$(IntermediateOutputPath)PulseAiDocumentGroundingService.g.cs</PulseAiGroundingGenerated>
    <PulseAiPrivateExtractorGenerated>$(IntermediateOutputPath)PulseAiPrivateDocumentExtractionService.g.cs</PulseAiPrivateExtractorGenerated>
    <PulseAiQuestionPlannerGenerated>$(IntermediateOutputPath)PulseAiQuestionPlanner.g.cs</PulseAiQuestionPlannerGenerated>
    <ProjectFinancialTruthGeneratedModule>$(IntermediateOutputPath)ProjectFinancialTruthModule.g.cs</ProjectFinancialTruthGeneratedModule>
    <AnalyticsCenterGeneratedModule>$(IntermediateOutputPath)AnalyticsCenterModule.g.cs</AnalyticsCenterGeneratedModule>
    <EnterpriseReportingGeneratedModule>$(IntermediateOutputPath)EnterpriseReportingModule.g.cs</EnterpriseReportingGeneratedModule>
    <EnterpriseReportingGeneratedRepository>$(IntermediateOutputPath)EnterpriseReportingRepository.g.cs</EnterpriseReportingGeneratedRepository>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Npgsql" Version="10.0.3" />
    <PackageReference Include="ClosedXML" Version="0.105.0" />
    <PackageReference Include="PdfPig" Version="0.1.10" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Assets/Branding/USSNavyStacked.png" LogicalName="ProjectTime.Api.Assets.Branding.USSNavyStacked.png" />
    <EmbeddedResource Include="Assets/Branding/USSNavyStacked.jpg" LogicalName="ProjectTime.Api.Assets.Branding.USSNavyStacked.jpg" />
  </ItemGroup>

  <!-- Canonical oversized sources remain reviewable. Generated compile copies
       insert endpoint registrations and normalize compiler-sensitive expressions. -->
  <ItemGroup>
    <Compile Remove="Program.cs" />
    <Compile Remove="Modules/ScopedRolePolicyModule.cs" />
    <Compile Remove="Modules/ScopedRolePolicyPersistence.cs" />
    <Compile Remove="Modules/DynamicRbacAdministrationModule.cs" />
    <Compile Remove="Modules/CrmErpIntegrationModule.cs" />
    <Compile Remove="Modules/CrmErpAdministrationExperience.cs" />
    <Compile Remove="Modules/Module001TimesheetContracts.cs" />
    <Compile Remove="Modules/Module001TimesheetData.cs" />
    <Compile Remove="Modules/Module001TimesheetEnhancementModule.cs" />
    <Compile Remove="Ai/PulseAiDocumentGroundingService.cs" />
    <Compile Remove="Ai/PulseAiPrivateDocumentExtractionService.cs" />
    <Compile Remove="Ai/PulseAiQuestionPlanner.cs" />
    <Compile Remove="Modules/ProjectFinancialTruthModule.cs" />
    <Compile Remove="Modules/AnalyticsCenterModule.cs" />
    <Compile Remove="Modules/EnterpriseReportingModule.cs" />
    <Compile Remove="Modules/EnterpriseReportingRepository.cs" />
  </ItemGroup>

  <Target Name="GenerateScopedRbacSources" BeforeTargets="CoreCompile">
    <MakeDir Directories="$(IntermediateOutputPath)" />
    <Exec Command="awk 'BEGIN { print &quot;#nullable enable&quot;; inserted=0 } /^[[:space:]]*app\.Run\(\);[[:space:]]*$/ &amp;&amp; inserted==0 { print &quot;app.UsePlatformOperationsTelemetry();&quot;; print &quot;app.MapPlatformOperationsEndpoints();&quot;; print &quot;app.MapPlatformProductionResilienceEndpoints();&quot;; print &quot;app.MapProjectFinancialTruthEndpoints();&quot;; print &quot;app.UseProjectNotificationCloseoutCompatibility();&quot;; print &quot;app.MapProjectNotificationAutomationEndpoints();&quot;; print &quot;app.MapFinancialOperationsRecoveryEndpoints();&quot;; print &quot;app.MapEnterpriseReportingEndpoints();&quot;; print &quot;app.MapAnalyticsCenterEndpoints();&quot;; print &quot;app.MapAdminAuditHistoryEndpoints();&quot;; print &quot;app.MapUserAdministrationTeamScopeEndpoints();&quot;; print &quot;app.UseModuleAvailabilityEnforcement();&quot;; print &quot;app.MapModuleAvailabilityEndpoints();&quot;; print &quot;app.MapModuleAvailabilityOverrideEndpoints();&quot;; print &quot;app.MapClientDiagnosticEndpoints();&quot;; print &quot;app.MapPulseAiDeepIntelligenceEndpoints();&quot;; print &quot;app.MapPulseAiPrivateDocumentPipelineEndpoints();&quot;; print &quot;app.MapScopedRolePolicyEndpoints();&quot;; print &quot;app.UsePtcTimeStewardRoleBoundary();&quot;; print &quot;app.UseModule001ResultExecutionCompatibility();&quot;; print &quot;app.MapModule001TimeStewardV2Endpoints();&quot;; print &quot;app.MapModule001TimesheetEnhancementEndpoints();&quot;; print &quot;app.MapModule001TimerTargetEndpoints();&quot;; print &quot;app.MapModule001PtcTimesheetManagementEndpoints();&quot;; print &quot;app.MapRuntimeDataCompatibilityEndpoints();&quot;; print &quot;app.MapCombinedModuleRuntimeEndpoints();&quot;; print &quot;app.MapCombinedModulePublicReadinessEndpoint();&quot;; print &quot;app.UseProjectExpenseBillingReadinessContinuitySafe();&quot;; print &quot;app.MapModule005ProjectExpenseUploadEndpointsSafe();&quot;; print &quot;app.MapModule005ProjectExpenseBillingAcknowledgementEndpoints();&quot;; print &quot;app.MapModule038CertifyConnectionEndpoints();&quot;; print &quot;app.UseCrmErpOAuthPersistence();&quot;; print &quot;app.MapCrmErpOAuthPersistenceEndpoints();&quot;; print &quot;app.UseEntraSecretExpirationGovernance();&quot;; print &quot;app.MapEntraSecretExpirationGovernanceEndpoints();&quot;; inserted=1 } { print } END { if (inserted==0) exit 42 }' &quot;$(MSBuildProjectDirectory)/Program.cs&quot; &gt; &quot;$(ScopedRbacGeneratedProgram)&quot;" />
    <!-- The canonical Program.cs retains the historic generic Entra names for reviewability.
         The compiled SSO handlers consume the separate active SSO profile, while Graph,
         calendar, identity, and Module 010 continue using their existing services variables. -->
    <Exec Command="sed -i -e 's/PROJECTPULSE_ENTRA_TENANT_ID/PROJECTPULSE_SSO_TENANT_ID/g' -e 's/PROJECTPULSE_ENTRA_CLIENT_ID/PROJECTPULSE_SSO_CLIENT_ID/g' -e 's/PROJECTPULSE_ENTRA_REDIRECT_URI/PROJECTPULSE_SSO_REDIRECT_URI/g' -e 's/PROJECTPULSE_ENTRA_CLIENT_SECRET/PROJECTPULSE_SSO_CLIENT_SECRET/g' &quot;$(ScopedRbacGeneratedProgram)&quot;" />
    <Exec Command="sed -e 's/reader.IsDBNull(7) ? null : reader.GetGuid(7)/reader.IsDBNull(7) ? (Guid?)null : reader.GetGuid(7)/' -e 's/reader.IsDBNull(9) ? null : reader.GetFieldValue&lt;DateTimeOffset&gt;(9)/reader.IsDBNull(9) ? (DateTimeOffset?)null : reader.GetFieldValue&lt;DateTimeOffset&gt;(9)/' -e 's/reader.IsDBNull(10) ? null : reader.GetFieldValue&lt;DateTimeOffset&gt;(10)/reader.IsDBNull(10) ? (DateTimeOffset?)null : reader.GetFieldValue&lt;DateTimeOffset&gt;(10)/' &quot;$(MSBuildProjectDirectory)/Modules/ScopedRolePolicyModule.cs&quot; &gt; &quot;$(ScopedRbacGeneratedModule)&quot;" />
    <Exec Command="sed -e 's/reader.IsDBNull(3) ? null : reader.GetGuid(3)/reader.IsDBNull(3) ? (Guid?)null : reader.GetGuid(3)/' -e 's/reader.IsDBNull(5) ? null : reader.GetDecimal(5)/reader.IsDBNull(5) ? (decimal?)null : reader.GetDecimal(5)/' &quot;$(MSBuildProjectDirectory)/Modules/ScopedRolePolicyPersistence.cs&quot; &gt; &quot;$(ScopedRbacGeneratedPersistence)&quot;" />
    <!-- Dynamic RBAC and Module 001 are partials of the same type. Keep their
         operation-specific helpers distinct in the compiled copy without
         changing the reviewable source or the existing PTC behavior. -->
    <Exec Command="sed -e 's/ReasonRequired(/DynamicRbacReasonRequired(/g' -e 's/ActiveUserExistsAsync(/DynamicRbacActiveUserExistsAsync(/g' &quot;$(MSBuildProjectDirectory)/Modules/DynamicRbacAdministrationModule.cs&quot; &gt; &quot;$(DynamicRbacGeneratedModule)&quot;" />
    <!-- Module 026 keeps its reviewed secure provider implementation while the
         compiled partial delegates provider listing and management authority to
         the current editable administration experience. -->
    <Exec Command="sed -e 's/public static class CrmErpIntegrationModule/public static partial class CrmErpIntegrationModule/' -e 's/ListProvidersAsync(HttpContext context)/ListProvidersLegacyAsync(HttpContext context)/' -e 's/AuthorizeManageAsync(HttpContext context)/AuthorizeManageLegacyAsync(HttpContext context)/' -e 's/HasManageAuthorityAsync(HttpContext context)/HasManageAuthorityLegacyAsync(HttpContext context)/' &quot;$(MSBuildProjectDirectory)/Modules/CrmErpIntegrationModule.cs&quot; &gt; &quot;$(Module026GeneratedIntegration)&quot;" />
    <!-- Only the policy-first helper declaration is renamed. Its existing callers
         continue to invoke ResolveManageAuthorityAsync, which is the actual-session
         Super Administrator invariant implemented by CrmErpOAuthPersistence.cs. -->
    <Exec Command="sed -e 's/private static async Task&lt;ManageAuthority&gt; ResolveManageAuthorityAsync(/private static async Task&lt;ManageAuthority&gt; ResolveManageAuthorityPolicyFirstAsync(/' &quot;$(MSBuildProjectDirectory)/Modules/CrmErpAdministrationExperience.cs&quot; &gt; &quot;$(CrmErpAdministrationExperienceGenerated)&quot;" />
    <Exec Command="sed -e 's/value.HasValue ? value.Value : DBNull.Value/value.HasValue ? (object)value.Value : DBNull.Value/' &quot;$(MSBuildProjectDirectory)/Modules/Module001TimesheetContracts.cs&quot; &gt; &quot;$(Module001GeneratedContracts)&quot;" />
    <Exec Command="sed -e 's/if (value is Guid id) existingId = id;/if (value is Guid foundEntryId) existingId = foundEntryId;/' &quot;$(MSBuildProjectDirectory)/Modules/Module001TimesheetData.cs&quot; &gt; &quot;$(Module001GeneratedData)&quot;" />
    <Exec Command="sed -e 's/reader.IsDBNull(1) ? null : reader.GetGuid(1)/reader.IsDBNull(1) ? (Guid?)null : reader.GetGuid(1)/' -e 's/reader.IsDBNull(3) ? null : reader.GetGuid(3)/reader.IsDBNull(3) ? (Guid?)null : reader.GetGuid(3)/' -e 's/reader.IsDBNull(4) ? null : reader.GetGuid(4)/reader.IsDBNull(4) ? (Guid?)null : reader.GetGuid(4)/' &quot;$(MSBuildProjectDirectory)/Modules/Module001TimesheetEnhancementModule.cs&quot; &gt; &quot;$(Module001GeneratedEndpoints)&quot;" />
    <!-- Pulse AI keeps the canonical permission-aware grounding source readable.
         The compiled copy materializes ordered role evidence for the existing
         IReadOnlyList response contract without changing authorization behavior. -->
    <Exec Command="sed -e 's/roles: access.RoleCodes,/roles: access.RoleCodes.OrderBy(value =&gt; value).ToArray(),/' &quot;$(MSBuildProjectDirectory)/Ai/PulseAiDocumentGroundingService.cs&quot; &gt; &quot;$(PulseAiGroundingGenerated)&quot;" />
    <!-- ClosedXML defines its own LoadOptions type and no longer exposes the old
         XLEventTracking constructor argument. Keep the canonical extractor easy
         to review while compiling an API-version-normalized copy. -->
    <Exec Command="sed -e 's/LoadOptions\.PreserveWhitespace/System.Xml.Linq.LoadOptions.PreserveWhitespace/g' -e 's/new XLWorkbook(source.StoragePath, XLEventTracking.Disabled)/new XLWorkbook(source.StoragePath)/' &quot;$(MSBuildProjectDirectory)/Ai/PulseAiPrivateDocumentExtractionService.cs&quot; &gt; &quot;$(PulseAiPrivateExtractorGenerated)&quot;" />
    <!-- Stable product-purpose questions should receive a direct answer rather
         than the generic future multi-tool plan. The canonical planner remains
         reviewable while the compiled copy composes the approved knowledge catalog. -->
    <Exec Command="sed -e 's/var directAnswer = FindKnowledgeAnswer(normalized);/var directAnswer = PulseAiProductKnowledgeCatalog.Find(normalized) ?? FindKnowledgeAnswer(normalized);/' &quot;$(MSBuildProjectDirectory)/Ai/PulseAiQuestionPlanner.cs&quot; &gt; &quot;$(PulseAiQuestionPlannerGenerated)&quot;" />
    <!-- Group 5 extends the authoritative Group 3 financial source through a partial
         bridge. The reviewable Group 3 source remains unchanged. -->
    <Exec Command="sed -e 's/public static class ProjectFinancialTruthModule/public static partial class ProjectFinancialTruthModule/' &quot;$(MSBuildProjectDirectory)/Modules/ProjectFinancialTruthModule.cs&quot; &gt; &quot;$(ProjectFinancialTruthGeneratedModule)&quot;" />
    <!-- Module 030 was recreated after an abandoned migration-054 branch. Compile
         compatibility copies against the authoritative migration-055 contract. -->
    <Exec Command="sed -e 's/migration_054_required/migration_055_required/g' -e 's/migration 054/migration 055/g' &quot;$(MSBuildProjectDirectory)/Modules/AnalyticsCenterModule.cs&quot; &gt; &quot;$(AnalyticsCenterGeneratedModule)&quot;" />
    <Exec Command="sed -e 's/migration_054_required/migration_055_required/g' -e 's/migration 054/migration 055/g' -e 's/Enterprise Reporting/Analytics Center/g' &quot;$(MSBuildProjectDirectory)/Modules/EnterpriseReportingModule.cs&quot; &gt; &quot;$(EnterpriseReportingGeneratedModule)&quot;" />
    <Exec Command="sed -e 's/054_enterprise_reporting_center/055_analytics_center/g' -e 's/null, null, null, null, null, null, null, null, 500, false/null, null, null, null, null, null, null, 500, false/' &quot;$(MSBuildProjectDirectory)/Modules/EnterpriseReportingRepository.cs&quot; &gt; &quot;$(EnterpriseReportingGeneratedRepository)&quot;" />
    <ItemGroup>
      <Compile Include="$(ScopedRbacGeneratedProgram)" />
      <Compile Include="$(ScopedRbacGeneratedModule)" />
      <Compile Include="$(ScopedRbacGeneratedPersistence)" />
      <Compile Include="$(DynamicRbacGeneratedModule)" />
      <Compile Include="$(Module026GeneratedIntegration)" />
      <Compile Include="$(CrmErpAdministrationExperienceGenerated)" />
      <Compile Include="$(Module001GeneratedContracts)" />
      <Compile Include="$(Module001GeneratedData)" />
      <Compile Include="$(Module001GeneratedEndpoints)" />
      <Compile Include="$(PulseAiGroundingGenerated)" />
      <Compile Include="$(PulseAiPrivateExtractorGenerated)" />
      <Compile Include="$(PulseAiQuestionPlannerGenerated)" />
      <Compile Include="$(ProjectFinancialTruthGeneratedModule)" />
      <Compile Include="$(AnalyticsCenterGeneratedModule)" />
      <Compile Include="$(EnterpriseReportingGeneratedModule)" />
      <Compile Include="$(EnterpriseReportingGeneratedRepository)" />
    </ItemGroup>
  </Target>
</Project>
